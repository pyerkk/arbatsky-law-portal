{
  "name": "arbatsky-overlay-web",
  "version": "1.0.0",
  "private": true,
  "description": "Неофициальный игровой правовой портал Арбатский",
  "main": "main.js",
  "scripts": {"start": "electron .", "test": "node --test tests/*.test.js", "build:win": "electron-builder --win nsis --x64 --publish never"},
  "devDependencies": {"electron": "42.4.0", "electron-builder": "26.0.12"},
  "build": {
    "appId": "online.arbatsky.law.overlay",
    "productName": "Arbatsky Map Overlay",
    "directories": {"output": "release"},
    "files": ["main.js", "preload.js", "desktop.css", "database.js", "icon.png", "web/**/*"],
    "win": {"target": ["nsis"], "signAndEditExecutable": false},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false}
  }
}
