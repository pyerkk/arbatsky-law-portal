<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ArbatskyOverlay</AssemblyName>
    <RootNamespace>ArbatskyOverlay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../dist/extended.json;../../dist/catalog.json;../../dist/references.json;../../dist/summaries.json;../../dist/pgo.json;../../dist/cheats.json;../../dist/general.json" LogicalName="Data.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
