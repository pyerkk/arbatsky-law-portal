<Window x:Class="ArbatskyOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Правовой портал | Арбатский" Width="760" Height="720" MinWidth="560" MinHeight="400"
 WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" Background="Transparent"
 Topmost="True" KeyDown="Window_KeyDown" Closing="Window_Closing" LocationChanged="GeometryChanged" SizeChanged="GeometryChanged">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#E7ECE8"/><SolidColorBrush x:Key="Quiet" Color="#9BAAA1"/><SolidColorBrush x:Key="Accent" Color="#D2A599"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E7ECE8"/><Setter Property="Background" Value="#29332F"/><Setter Property="BorderBrush" Value="#526157"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#EFF4EF"/><Setter Property="Background" Value="#202824"/><Setter Property="BorderBrush" Value="#516157"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE5DE"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Foreground" Value="#202622"/><Setter Property="Margin" Value="0,0,6,6"/></Style>
 </Window.Resources>
 <Border Background="#F21A201D" BorderBrush="#617466" BorderThickness="1" CornerRadius="8">
  <Grid Margin="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,12">
    <Button Content="✕" DockPanel.Dock="Right" Click="Hide_Click" ToolTip="Скрыть окно"/>
    <Button Content="⚙" DockPanel.Dock="Right" Click="Settings_Click" ToolTip="Настройки"/>
    <StackPanel><TextBlock Text="АРБАТСКИЙ  /  ПРАВОВОЙ ПОРТАЛ" FontWeight="Bold" FontSize="15"/><TextBlock Text="НЕОФИЦИАЛЬНЫЙ ИГРОВОЙ СПРАВОЧНИК" FontSize="10" Foreground="{StaticResource Quiet}" Margin="0,3,0,0"/></StackPanel>
   </DockPanel>
   <WrapPanel Grid.Row="1" x:Name="Navigation" Margin="0,0,0,6">
    <Button Content="Популярное" Tag="popular" Click="Section_Click"/><Button Content="УК" Tag="uk" Click="Section_Click"/><Button Content="УПК" Tag="upk" Click="Section_Click"/><Button Content="КоАП" Tag="koap" Click="Section_Click"/><Button Content="ПГО" Tag="pgo" Click="Section_Click"/><Button Content="ФСБ" Tag="fsb" Click="Section_Click"/><Button Content="Задержание" Tag="detention" Click="Section_Click"/><Button Content="Шпаргалки" Tag="cheats" Click="Section_Click"/><Button Content="★ Избранное" Tag="favorites" Click="Section_Click"/><Button Content="Шаблон" Tag="template" Click="Section_Click"/><Button Content="Моя подборка" Tag="collection" Click="Section_Click"/>
   </WrapPanel>
   <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox x:Name="Search" ToolTip="Номер, название или ключевое слово" TextChanged="Search_Changed"/><ComboBox x:Name="Filter" Grid.Column="1" SelectionChanged="Search_Changed" Margin="8,0,0,0" /></Grid>
   <Grid Grid.Row="3">
    <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ItemsPanel"/></ScrollViewer>
    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="4">
     <TextBlock Text="Настройки" FontSize="24" FontFamily="Georgia" Margin="0,0,0,14"/>
     <TextBlock Text="Открыть / скрыть (например, Ctrl+Shift+Space)" Foreground="{StaticResource Quiet}"/><TextBox x:Name="ToggleKey" Margin="0,5,0,12"/>
     <TextBlock Text="Включить / выключить режим просмотра (например, Ctrl+Shift+F2)" Foreground="{StaticResource Quiet}"/><TextBox x:Name="PassKey" Margin="0,5,0,12"/>
     <TextBlock Text="Прозрачность окна" Foreground="{StaticResource Quiet}"/><Slider x:Name="OpacitySlider" Minimum="0.45" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,12"/>
     <CheckBox x:Name="AlwaysOnTop" Content="Окно поверх других окон"/><CheckBox x:Name="StartWithWindows" Content="Запускать вместе с Windows (в фоне)"/>
     <TextBlock Text="В режиме просмотра нажатия проходят сквозь окно. Для возвращения к управлению используйте горячую клавишу или меню в трее." Foreground="{StaticResource Quiet}" Margin="0,10,0,14"/>
     <WrapPanel><Button Content="Сохранить настройки" Click="SaveSettings_Click"/><Button Content="Проверить обновление базы" Click="Update_Click" x:Name="UpdateButton"/><Button Content="Назад" Click="Back_Click"/></WrapPanel>
     <TextBlock x:Name="DataStatus" Foreground="{StaticResource Quiet}" Margin="0,10,0,0"/>
     <TextBlock Text="Игра в оконном или безрамочном режиме обычно лучше подходит для оверлеев. Эксклюзивный полноэкранный режим может не показывать окно. Совместимость с игрой и её правилами необходимо проверить." Foreground="{StaticResource Quiet}" Margin="0,16,0,0"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <TextBlock Grid.Row="4" x:Name="Status" Text="Сверяйте условия и актуальность на форуме." Foreground="{StaticResource Quiet}" FontSize="11" Margin="0,10,0,4"/>
  </Grid>
 </Border>
</Window>
